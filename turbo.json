{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "API_URL",
        "BASE_URL",
        "DASHBOARD_URL",
        "DOCS_URL",
        "KNOWLEDGE_BASE_URL",
        "SKIP_TYPECHECK",
        "NEXT_TELEMETRY_DISABLED"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
