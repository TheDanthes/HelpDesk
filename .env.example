# Copiar a .env para desarrollo local.
# En ZimaOS los valores van en deploy/zimaos/docker-compose.yml.

# Base de datos (coincide con docker-compose.yml de desarrollo)
DATABASE_URL=postgresql://ondesk:ondesk@localhost:5432/ondesk

# Clave que firma las sesiones, en base64. Generar la propia con:
#   openssl rand -base64 32
SECRET=Q0FNQklBTUUtRVNUQS1DTEFWRS1BTlRFUy1ERS1VU0FS

# Donde el dashboard encuentra la API.
# Ojo: Next lo inyecta en tiempo de build, no de arranque.
API_URL=http://localhost:3001

NODE_ENV=development
